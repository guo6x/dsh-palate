{
  "name": "dsh-palate",
  "version": "0.6.2",
  "description": "An eye that grows: accumulated design taste for DSH agents. A taste corpus + codified principles that sharpen with every example you feed — review designs against learned judgment, not a fixed ruler.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "demo",
    "docs",
    "cordis.patch.yml",
    "dsh.plugin.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["slots", "locale", "layout", "connection"],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "demo": "node build.mjs && node demo/first-run.mjs",
    "test": "node build.mjs && node tests/smoke.mjs && node tests/plugin-contract.mjs && node tests/client-contract.mjs && node demo/first-run.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "design",
    "taste",
    "aesthetic",
    "review",
    "critique",
    "visual-training",
    "reference-packs",
    "ux"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guo6x/dsh-palate.git"
  }
}
